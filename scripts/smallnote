#!/bin/zsh
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
APP_BUNDLE="$ROOT/SmallNoteDesktop.app"
APP="$APP_BUNDLE/Contents/MacOS/SmallNoteDesktop"
APP_ID="com.andrew.xiaobianqian.desktop"
DATA_DIR="${XIAOBIANQIAN_DATA_DIR:-$HOME/Library/Application Support/xiaobianqian}"
NOTES="$DATA_DIR/notes.json"
DELETED="$DATA_DIR/deleted.json"
HOTWORDS="$DATA_DIR/voice-hotwords.txt"
APP_PROCESS_PATTERN="${APP}$"

mkdir -p "$DATA_DIR"

build_app_if_needed() {
  if [[ ! -x "$APP" || ! -f "$APP_BUNDLE/Contents/Info.plist" || "$ROOT/SmallNoteDesktop.swift" -nt "$APP" || "$ROOT/smallnote" -nt "$APP_BUNDLE/Contents/Info.plist" ]]; then
    mkdir -p "$APP_BUNDLE/Contents/MacOS" "$APP_BUNDLE/Contents/Resources"
    /usr/bin/swiftc "$ROOT/SmallNoteDesktop.swift" -o "$APP" -framework AppKit -framework CoreGraphics -framework Carbon -framework AVFAudio -framework QuartzCore
    cat > "$APP_BUNDLE/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>SmallNoteDesktop</string>
  <key>CFBundleIdentifier</key>
  <string>com.andrew.xiaobianqian.desktop</string>
  <key>CFBundleName</key>
  <string>小便签</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSBackgroundOnly</key>
  <false/>
  <key>LSUIElement</key>
  <false/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>用于将语音转换为小便签。</string>
</dict>
</plist>
EOF
    /usr/bin/xattr -cr "$APP_BUNDLE" 2>/dev/null || true
    /usr/bin/codesign --force --deep --sign - "$APP_BUNDLE" >/dev/null 2>&1
  fi
}

ensure_app() {
  build_app_if_needed
  /bin/launchctl setenv XIAOBIANQIAN_CLI "$ROOT/smallnote" >/dev/null 2>&1 || true
  /bin/launchctl setenv XIAOBIANQIAN_DATA_DIR "$DATA_DIR" >/dev/null 2>&1 || true
  if [[ -n "${XIAOBIANQIAN_OBSIDIAN_VAULT:-}" ]]; then
    /bin/launchctl setenv XIAOBIANQIAN_OBSIDIAN_VAULT "$XIAOBIANQIAN_OBSIDIAN_VAULT" >/dev/null 2>&1 || true
  fi
  if [[ -n "${XIAOBIANQIAN_OBSIDIAN_NOTE:-}" ]]; then
    /bin/launchctl setenv XIAOBIANQIAN_OBSIDIAN_NOTE "$XIAOBIANQIAN_OBSIDIAN_NOTE" >/dev/null 2>&1 || true
  fi
  if ! /usr/bin/pgrep -f "$APP_PROCESS_PATTERN" >/dev/null 2>&1; then
    /usr/bin/open -j "$APP_BUNDLE"
  fi
}

stop_running_notes_app() {
  # Ask the AppKit app to quit normally first. This runs
  # applicationWillTerminate, which stops AVAudioEngine and unregisters the
  # global hotkeys before the process exits.
  /usr/bin/osascript -e "tell application id \"$APP_ID\" to quit" >/dev/null 2>&1 || true
  for _ in {1..30}; do
    if ! pgrep -f "$APP_PROCESS_PATTERN" >/dev/null 2>&1; then
      return 0
    fi
    /bin/sleep 0.1
  done

  # A hung copy should not block the command forever. Give it a normal signal
  # first, then use SIGKILL only as the last resort.
  /usr/bin/pkill -TERM -f "$APP_PROCESS_PATTERN" >/dev/null 2>&1 || true
  for _ in {1..10}; do
    if ! pgrep -f "$APP_PROCESS_PATTERN" >/dev/null 2>&1; then
      return 0
    fi
    /bin/sleep 0.1
  done
  /usr/bin/pkill -KILL -f "$APP_PROCESS_PATTERN" >/dev/null 2>&1 || true
}

case "${1:-}" in
  add)
    shift || true
    text_parts=()
    attachment_paths=()
    note_title=""
    note_tags=""
    state="text"
    for arg in "$@"; do
      case "$state" in
        text)
          if [[ "$arg" == "--" ]]; then
            state="attachments"
          elif [[ "$arg" == "--title" ]]; then
            state="expect_title"
          elif [[ "$arg" == "--tags" ]]; then
            state="expect_tags"
          else
            text_parts+=("$arg")
          fi
          ;;
        expect_title)
          note_title="$arg"
          state="text"
          ;;
        expect_tags)
          note_tags="$arg"
          state="text"
          ;;
        attachments)
          attachment_paths+=("$arg")
          ;;
      esac
    done
    text="${text_parts[*]}"
    if [[ -z "$text" ]]; then
      echo "请在 add 后面写小便签内容。"
      exit 1
    fi
    /usr/bin/python3 - "$NOTES" "$DATA_DIR" "$text" "$note_title" "$note_tags" "${attachment_paths[@]}" <<'PY'
import json
import os
import shutil
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

path, data_dir, text = sys.argv[1], sys.argv[2], sys.argv[3]
note_title = sys.argv[4] if len(sys.argv) > 4 else ""
note_tags = sys.argv[5] if len(sys.argv) > 5 else ""
attachment_inputs = sys.argv[6:]
os.makedirs(os.path.dirname(path), exist_ok=True)

try:
    default_color = int(subprocess.check_output([
        "/usr/bin/defaults",
        "read",
        "com.andrew.xiaobianqian.desktop",
        "smallNoteDefaultCategory",
    ], text=True).strip())
except Exception:
    default_color = 0
if default_color not in {0, 1, 2, 3, 4}:
    default_color = 0

try:
    with open(path, "r", encoding="utf-8") as f:
        notes = json.load(f)
except Exception:
    notes = []

note_id = str(uuid.uuid4())
attachment_dir = Path(data_dir) / "attachments" / note_id
attachments = []

def kind_for(file_path):
    suffix = Path(file_path).suffix.lower()
    if suffix in {".png", ".jpg", ".jpeg", ".gif", ".heic", ".webp", ".tiff", ".bmp"}:
        return "image"
    if suffix == ".pdf":
        return "pdf"
    if suffix in {".md", ".markdown"}:
        return "markdown"
    return "file"

for source in attachment_inputs:
    source_path = Path(source).expanduser()
    if not source_path.is_file():
        continue
    attachment_dir.mkdir(parents=True, exist_ok=True)
    destination = attachment_dir / source_path.name
    if destination.exists():
        stem, suffix = source_path.stem, source_path.suffix
        counter = 2
        while destination.exists():
            destination = attachment_dir / f"{stem}-{counter}{suffix}"
            counter += 1
    shutil.copy2(source_path, destination)
    attachments.append({
        "name": source_path.name,
        "path": str(destination),
        "type": kind_for(source_path),
    })

notes.append({
    "id": note_id,
    "text": text,
    "color": default_color,
    "createdAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "archivedAt": None,
    "attachments": attachments,
    "title": note_title,
    "tags": note_tags,
})

with open(path, "w", encoding="utf-8") as f:
    json.dump(notes, f, ensure_ascii=False, indent=2)
PY
    ensure_app
    echo "已添加小便签。"
    ;;
  clear)
    /usr/bin/python3 - "$NOTES" "$DELETED" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

notes_path, deleted_path = sys.argv[1], sys.argv[2]
try:
    with open(notes_path, encoding="utf-8") as f:
        notes = json.load(f)
except Exception:
    notes = []
try:
    with open(deleted_path, encoding="utf-8") as f:
        deleted = json.load(f)
except Exception:
    deleted = []

if notes:
    deleted.append({
        "deletedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "reason": "clear",
        "notes": notes,
    })
    os.makedirs(os.path.dirname(deleted_path), exist_ok=True)
    with open(deleted_path, "w", encoding="utf-8") as f:
        json.dump(deleted, f, ensure_ascii=False, indent=2)

os.makedirs(os.path.dirname(notes_path), exist_ok=True)
with open(notes_path, "w", encoding="utf-8") as f:
    json.dump([], f, ensure_ascii=False, indent=2)
PY
    ensure_app
    echo "已清空小便签。"
    ;;
  restore)
    /usr/bin/python3 - "$NOTES" "$DELETED" <<'PY'
import json
import os
import sys

notes_path, deleted_path = sys.argv[1], sys.argv[2]
try:
    deleted = json.load(open(deleted_path, encoding="utf-8"))
except Exception:
    deleted = []

if not deleted:
    print("没有可恢复的小便签。")
    raise SystemExit(0)

batch = deleted.pop()
try:
    current = json.load(open(notes_path, encoding="utf-8"))
except Exception:
    current = []

current_ids = {note.get("id") for note in current}
restored = [note for note in batch.get("notes", []) if note.get("id") not in current_ids]
current.extend(restored)

os.makedirs(os.path.dirname(notes_path), exist_ok=True)
with open(notes_path, "w", encoding="utf-8") as f:
    json.dump(current, f, ensure_ascii=False, indent=2)
with open(deleted_path, "w", encoding="utf-8") as f:
    json.dump(deleted, f, ensure_ascii=False, indent=2)

print(f"已恢复 {len(restored)} 条小便签。")
PY
    ensure_app
    ;;
  archive)
    shift || true
    note_id="${1:-}"
    if [[ -z "$note_id" ]]; then
      echo "请提供要存入语音笔记的小便签 ID。"
      exit 1
    fi
    /usr/bin/python3 - "$NOTES" "$note_id" <<'PY'
import json
import fcntl
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from collections import Counter
from datetime import datetime
from pathlib import Path

notes_path, note_id = sys.argv[1], sys.argv[2]
vault_root_value = os.environ.get("XIAOBIANQIAN_OBSIDIAN_VAULT", "").strip()
target_value = os.environ.get("XIAOBIANQIAN_OBSIDIAN_NOTE", "").strip()
if not vault_root_value or not target_value:
    print("请先设置 XIAOBIANQIAN_OBSIDIAN_VAULT 和 XIAOBIANQIAN_OBSIDIAN_NOTE 后再归档。")
    raise SystemExit(1)

vault_root = Path(vault_root_value).expanduser()
target = Path(target_value).expanduser()
if not target.is_absolute():
    target = vault_root / target
vault_attachment_root = vault_root / "资料库/附件/小便签" / note_id

try:
    notes = json.load(open(notes_path, encoding="utf-8"))
except Exception:
    notes = []

note = next((item for item in notes if item.get("id") == note_id), None)
if not note:
    print("没有找到这条小便签。")
    raise SystemExit(1)

if note.get("archivedAt"):
    print("这条小便签已经存入语音笔记。")
    raise SystemExit(0)

text = str(note.get("text", "")).strip()
if not text:
    print("便签正文为空，未存入语音笔记。", file=sys.stderr)
    raise SystemExit(1)

KEYCHAIN_SERVICE = os.environ.get(
    "XIAOBIANQIAN_DEEPSEEK_KEYCHAIN_SERVICE",
    "com.xiaobianqian.deepseek-api",
)
KEYCHAIN_ACCOUNT = os.environ.get("XIAOBIANQIAN_DEEPSEEK_KEYCHAIN_ACCOUNT", os.environ.get("USER", ""))
MODEL = os.environ.get("XIAOBIANQIAN_DEEPSEEK_MODEL", "deepseek-v4-flash")
API_URL = os.environ.get(
    "XIAOBIANQIAN_DEEPSEEK_API_URL",
    "https://api.deepseek.com/chat/completions",
)

def read_api_key():
    configured = os.environ.get("XIAOBIANQIAN_DEEPSEEK_API_KEY", "").strip()
    if configured:
        return configured
    # The key is deliberately kept out of notes.json and the app bundle.
    try:
        result = subprocess.run(
            ["/usr/bin/security", "find-generic-password", "-a", KEYCHAIN_ACCOUNT, "-s", KEYCHAIN_SERVICE, "-w"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise RuntimeError("没有找到 DeepSeek API Key；请重新配置小便签。") from error
    key = result.stdout.strip()
    if not key:
        raise RuntimeError("DeepSeek API Key 为空；请重新配置小便签。")
    return key

def normalize_metadata(value):
    if not isinstance(value, dict):
        raise ValueError("AI 返回格式无效")
    title = " ".join(str(value.get("title", "")).split()).strip("#：:。.!！?？ ")
    callout_title = " ".join(str(value.get("callout_title", "")).split()).strip("#：:。.!！?？ ")
    polished_text = str(value.get("polished_text", "")).strip()
    raw_tags = value.get("tags")
    if not isinstance(raw_tags, list):
        raise ValueError("AI 没有返回标签列表")
    tags = []
    for raw_tag in raw_tags:
        tag = "".join(str(raw_tag).split()).lstrip("#").strip("，,。.!！?？#")
        if tag and tag not in tags:
            tags.append(tag)
    if not title or len(title) > 20 or not callout_title or len(callout_title) > 10 or len(tags) != 3:
        raise ValueError("AI 返回的标题、摘要标题或三个标签不符合要求")
    return title, callout_title, polished_text, " ".join(f"#{tag}" for tag in tags)

def validate_polished_text(original, polished):
    if not polished:
        raise ValueError("AI 没有返回润色后的正文")
    if len(polished) > len(original) * 4 + 200:
        raise ValueError("AI 润色结果异常冗长")

    # These tokens are factual anchors: do not let a stylistic rewrite silently drop them.
    token_pattern = re.compile(r"https?://[^\\s]+|[A-Za-z][A-Za-z0-9_.@/-]*|\\d[\\d,.:/-]*[年月日时分秒次元%％号]*|[“\"《【][^”\"》】]{1,80}[”\"》】]")
    required = Counter(token_pattern.findall(original))
    available = Counter(token_pattern.findall(polished))
    missing = [token for token, count in required.items() if available[token] < count]
    if missing:
        raise ValueError("AI 润色遗漏了原文中的关键信息")
    return polished

def generate_metadata(body):
    prompt = (
        "请为下面这条个人语音笔记生成归档元数据。只返回 JSON 对象，不要 Markdown。"
        "JSON 必须是 {\\\"title\\\": \\\"…\\\", \\\"callout_title\\\": \\\"…\\\", \\\"polished_text\\\": \\\"…\\\", \\\"tags\\\": [\\\"…\\\", \\\"…\\\", \\\"…\\\"]}。"
        "title 为中文短标题，不超过20个字符；callout_title 是如 处理方案、会议要点、待办事项 这样的内容概括，不超过10个字符；"
        "tags 必须恰好三个，不能含 # 或空格，"
        "必须是内容相关关键词，禁止使用泛化标签如 小便签、语音笔记、闪念、快捷记录。"
        "polished_text 是原文的轻度润色版：只能调整语序、补足必要连接词、整理段落或列表；绝不能摘要、删减、合并或遗漏任何要点，"
        "不能添加原文没有的事实或推断。所有人物、地点、日期、数字、金额、药名、专名、引号内容、链接、待办和清单项必须完整保留。"
        "若原文已经通顺，polished_text 应原样返回。polished_text 中不要添加标题、标签、callout 或 Markdown 代码围栏。\\n\\n"
        f"笔记正文：\\n{body}"
    )
    payload = {
        "model": MODEL,
        "messages": [
            {"role": "system", "content": "你是严谨的中文个人知识库编辑。"},
            {"role": "user", "content": prompt},
        ],
        "thinking": {"type": "disabled"},
        "temperature": 0.2,
        "max_tokens": min(8192, max(360, int(len(body) * 1.6) + 200)),
        "response_format": {"type": "json_object"},
    }
    request = urllib.request.Request(
        API_URL,
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        headers={"Authorization": f"Bearer {read_api_key()}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            response_body = json.load(response)
        content = response_body["choices"][0]["message"]["content"]
        title, callout_title, polished_text, tags = normalize_metadata(json.loads(content))
        return title, callout_title, validate_polished_text(body, polished_text), tags
    except urllib.error.HTTPError as error:
        raise RuntimeError(f"DeepSeek 请求失败（HTTP {error.code}），未写入笔记。") from error
    except (urllib.error.URLError, TimeoutError) as error:
        raise RuntimeError("无法连接 DeepSeek，未写入笔记。") from error
    except (KeyError, IndexError, TypeError, ValueError, json.JSONDecodeError) as error:
        raise RuntimeError("DeepSeek 未返回完整、合格的润色正文与归档信息，未写入笔记。") from error

try:
    title, callout_title, polished_text, tags = generate_metadata(text)
except RuntimeError as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)

attachments = note.get("attachments") or []

# 时间戳取便签创建时间
created_at = note.get("createdAt", "")
try:
    dt = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    timestamp = dt.astimezone().strftime("%Y-%m-%d %H:%M")
except Exception:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")

def unique_destination(directory, name):
    destination = directory / name
    if not destination.exists():
        return destination
    stem = destination.stem
    suffix = destination.suffix
    counter = 2
    while True:
        candidate = directory / f"{stem}-{counter}{suffix}"
        if not candidate.exists():
            return candidate
        counter += 1

def wiki_link_for(path, label):
    relative = path.relative_to(vault_root).as_posix()
    return f"[[{relative}|{label}]]"

def archive_attachments():
    if not attachments:
        return []
    vault_attachment_root.mkdir(parents=True, exist_ok=True)
    results = []
    for item in attachments:
        source = Path(str(item.get("path", ""))).expanduser()
        name = str(item.get("name") or source.name or "附件")
        if not source.is_file():
            results.append({"name": name, "link": name, "copied": False})
            continue
        destination = unique_destination(vault_attachment_root, name)
        shutil.copy2(source, destination)
        results.append({"name": name, "link": wiki_link_for(destination, name), "copied": True})
    return results

archived_attachments = archive_attachments()

def quote_content(value):
    parts = [line.rstrip() for line in value.strip().splitlines()]
    if archived_attachments:
        if parts:
            parts.append("")
        parts.append("附件：" + "；".join(item["link"] for item in archived_attachments))
    return "\n".join(f"> {line}" if line else ">" for line in (parts or [""]))

entry = f"\n\n#### {title}\n> [!summary] {callout_title}\n{quote_content(polished_text)}\n\n**记录时间**：{timestamp}  \n**话题**： {tags}\n"

target.parent.mkdir(parents=True, exist_ok=True)
with target.open("a", encoding="utf-8") as f:
    fcntl.flock(f.fileno(), fcntl.LOCK_EX)
    f.write(entry)
    f.flush()
    fcntl.flock(f.fileno(), fcntl.LOCK_UN)

tail = target.read_text(encoding="utf-8")[-max(500, len(entry) + 50):]
if title not in tail or (archived_attachments and archived_attachments[0]["link"] not in tail):
    raise RuntimeError("写入后验证失败。")

archive_timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
for item in notes:
    if item.get("id") == note_id:
        item["archivedAt"] = archive_timestamp
        break
with open(notes_path, "w", encoding="utf-8") as f:
    json.dump(notes, f, ensure_ascii=False, indent=2)

print("已存入语音笔记。")
print(f"title={title}")
PY
    ;;
  list)
    /usr/bin/python3 - "$NOTES" <<'PY'
import json
import sys

try:
    notes = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    notes = []

if not notes:
    print("当前没有小便签。")
else:
    for idx, note in enumerate(notes, 1):
        attachments = note.get("attachments") or []
        suffix = f"（{len(attachments)} 个附件）" if attachments else ""
        print(f"{idx}. {note.get('text', '')}{suffix}")
PY
    ;;
  open)
    ensure_app
    echo "小便签桌面程序已打开。"
    ;;
  install)
    build_app_if_needed
    echo "本地 App 已构建到：$APP_BUNDLE"
    ;;
  stop)
    stop_running_notes_app
    echo "小便签桌面程序已关闭。"
    ;;
  doctor)
    build_app_if_needed
    echo "源码构建：$APP"
    echo "运行中的当前 App："
    pgrep -fl "$APP_PROCESS_PATTERN" || echo "  未运行"
    echo "当前便签数据：$NOTES"
    if [[ -f "$NOTES" ]]; then
      /usr/bin/python3 - "$NOTES" <<'PY'
import json
import sys
try:
    notes = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    notes = []
print(f"便签数量：{len(notes)}")
PY
    else
      echo "便签数量：0"
    fi
    echo "语音热词表：$HOTWORDS"
    if [[ -f "$HOTWORDS" ]]; then
      /usr/bin/python3 - "$HOTWORDS" <<'PY'
import sys

terms = []
for line in open(sys.argv[1], encoding="utf-8"):
    value = line.strip()
    if value and not value.startswith("#") and value not in terms:
        terms.append(value)
print(f"热词数量：{len(terms)}")
PY
    else
      echo "热词数量：0（文件不存在，将使用内置默认词表）"
    fi
    ;;
  hotwords)
    if [[ ! -f "$HOTWORDS" ]]; then
      echo "热词表不存在：$HOTWORDS"
      exit 1
    fi
    /usr/bin/open -a TextEdit "$HOTWORDS"
    echo "已用文本编辑打开语音热词表：$HOTWORDS"
    ;;
  *)
    cat <<'EOF'
用法：
  smallnote add 你的内容
  smallnote list
  smallnote clear
  smallnote restore
  smallnote archive NOTE_ID
  smallnote open
  smallnote hotwords
  smallnote stop
EOF
    ;;
esac
